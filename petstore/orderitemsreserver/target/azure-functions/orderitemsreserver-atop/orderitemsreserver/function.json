{
  "scriptFile" : "../orderitemsreserver-0.0.1-SNAPSHOT.jar",
  "entryPoint" : "com.chtrembl.petstore.reserver.Function.run",
  "bindings" : [ {
    "type" : "httpTrigger",
    "direction" : "in",
    "name" : "req",
    "methods" : [ "POST" ],
    "authLevel" : "ANONYMOUS"
  }, {
    "type" : "blob",
    "direction" : "out",
    "name" : "outputItem",
    "path" : "orderitemsreserver/{Query.sessionId}.json",
    "dataType" : "binary",
    "connection" : "AzureWebJobsStorage"
  }, {
    "type" : "http",
    "direction" : "out",
    "name" : "$return"
  } ]
}